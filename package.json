{
  "name": "i7-card-database",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview --port 4321",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "astro check --minimumSeverity warning",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "extract-fixtures": "node scripts/extract-test-fixtures.ts",
    "extract-point-calc-golden": "node scripts/extract-point-calc-golden.mjs",
    "prepare": "git config core.hooksPath .husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.1.0",
    "gsap": "^3.15.0",
    "modern-screenshot": "^4.7.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playform/compress": "0.2.3",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "1.74.0",
    "sharp": "^0.35.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^8"
  }
}
