---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventStatusBadge from '../../components/EventStatusBadge.svelte';
import EventBonusCardGrid from '../../components/EventBonusCardGrid.svelte';
import { fetchEventsCsv, formatEffectSummary, type EventRow, type EventSpecialTier } from '../../lib/data/fetchEventsCsv';
import { fetchCardsJson, type Card } from '../../lib/data/fetchCardsJson';
import { fetchSongsJson, filterValidSongs, getEventSongIds, type Song } from '../../lib/data/fetchSongsJson';
import { cardThumbUrl, songImageUrl, starsText } from '../../lib/ui';
import { isHighScoreEvent } from '../../lib/data/eventBonusTiers';
import { formatEventPeriod, formatEventEnd, eventEndMs } from '../../lib/data/eventPeriod';

export async function getStaticPaths() {
  const [events, cards, songs] = await Promise.all([
    fetchEventsCsv(),
    fetchCardsJson(),
    fetchSongsJson().then(filterValidSongs),
  ]);
  const songMap = new Map<number, Song>();
  for (const s of songs as Song[]) {
    if (s.id !== null) songMap.set(s.id, s);
  }
  const cardMap = new Map<number, Card>();
  for (const c of cards as Card[]) {
    if (c.ID !== null) cardMap.set(c.ID, c);
  }
  const pick = (ids: number[]): Card[] =>
    [...new Set(ids)].map(id => cardMap.get(id)).filter((c): c is Card => !!c);

  return (events as EventRow[]).map(ev => {
    const urOnly = isHighScoreEvent(ev.eventtype);
    const pickTier = (ids: number[]): Card[] => {
      const picked = pick(ids);
      return urOnly ? picked.filter(c => c.rarity === 'UR') : picked;
    };
    return {
      params: { id: String(ev.id) },
      props: {
        event: ev,
        goldCards: pickTier(ev.gold.cardIds),
        silverCards: pickTier(ev.silver.cardIds),
        bronzeCards: pickTier(ev.bronze.cardIds),
        songs: getEventSongIds(ev.id)
          .map(id => songMap.get(id))
          .filter((s): s is Song => !!s),
      },
    };
  });
}

interface Props {
  event: EventRow;
  goldCards: Card[];
  silverCards: Card[];
  bronzeCards: Card[];
  songs: Song[];
}

const { event, goldCards, silverCards, bronzeCards, songs } = Astro.props as Props;
const isHighScore = isHighScoreEvent(event.eventtype);
const base = import.meta.env.BASE_URL;

const goldNames = goldCards.map(c => c.cardname).filter(Boolean).slice(0, 3).join('・');
const ogDescription = `${event.eventname}（${event.eventtype}）の特効衣装・期間・ボーナス情報。${event.start_date}〜${formatEventEnd(event.end_date)}${goldNames ? ` 金特効: ${goldNames}` : ''}`;
const ogImageCard = goldCards[0] || silverCards[0] || bronzeCards[0];
const ogImage = ogImageCard?.ID !== null && ogImageCard?.ID !== undefined ? cardThumbUrl(ogImageCard.ID) : undefined;

const breadcrumbs = [
  { name: 'ホーム', url: base },
  { name: 'イベント情報', url: `${base}events/` },
  { name: event.eventname, url: `${base}events/${event.id}/` },
];

const eventLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.eventname,
  description: event.comment || ogDescription,
  startDate: `${event.start_date}T17:00:00+09:00`,
  // 終了日が未入力のイベントは endDate を出さない（schema.org/Event では任意）
  ...(eventEndMs(event.end_date) === null ? {} : { endDate: `${event.end_date}T17:00:00+09:00` }),
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'VirtualLocation',
    url: 'https://app.idolish7.com/',
  },
  organizer: {
    '@type': 'Organization',
    name: 'アイドリッシュセブン',
  },
  url: new URL(`${base}events/${event.id}/`, Astro.site).toString(),
  ...(ogImage ? { image: new URL(ogImage, Astro.site).toString() } : {}),
};

interface TierView {
  key: 'gold' | 'silver' | 'bronze';
  label: string;
  cards: Card[];
  tier: EventSpecialTier;
  badgeClass: string;
  borderClass: string;
}

const tiers: TierView[] = [
  {
    key: 'gold',
    label: '金特効',
    cards: goldCards,
    tier: event.gold,
    badgeClass: 'bg-yellow-100 text-yellow-800 border-yellow-400',
    borderClass: 'border-l-4 border-yellow-500',
  },
  {
    key: 'silver',
    label: '銀特効',
    cards: silverCards,
    tier: event.silver,
    badgeClass: 'bg-gray-200 text-gray-700 border-gray-400',
    borderClass: 'border-l-4 border-gray-400',
  },
  {
    key: 'bronze',
    label: '銅特効',
    cards: bronzeCards,
    tier: event.bronze,
    badgeClass: 'bg-amber-100 text-amber-800 border-amber-400',
    borderClass: 'border-l-4 border-amber-500',
  },
];
---

<BaseLayout
  title={event.eventname}
  description={ogDescription}
  image={ogImage}
  ogType="article"
  breadcrumbs={breadcrumbs}
  jsonLd={eventLd}
>
  <div class="mb-6">
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-2xl font-bold text-display">{event.eventname}</h1>
      <EventStatusBadge
        start_date={event.start_date}
        end_date={event.end_date}
        client:load
      />
    </div>
    <div class="mt-2 text-sm text-gray-600 space-y-0.5">
      <p>{event.eventtype}</p>
      <p>{formatEventPeriod(event.start_date, event.end_date)}</p>
    </div>
    {event.comment && (
      <p class="mt-3 text-sm text-gray-700 bg-gray-50 border border-gray-200 rounded px-3 py-2">{event.comment}</p>
    )}
  </div>

  {isHighScore && (
    <p
      data-testid="highscore-ur-note"
      class="mb-6 text-sm text-gray-800 bg-gray-100 border border-gray-300 rounded px-3 py-2"
    >
      ハイスコアライブイベントのため、UR 衣装のみ表示しています。
    </p>
  )}

  {tiers.map(t => (
    <section class={`mb-6 surface-card p-4 ${t.borderClass}`}>
      <EventBonusCardGrid
        label={t.label}
        badgeClass={t.badgeClass}
        effectSummary={formatEffectSummary(t.tier)}
        targetNote={t.key === 'bronze' ? event.special3_member : ''}
        cards={t.cards.map(c => ({
          ID: c.ID!,
          cardname: c.cardname || '',
          name: c.name || '',
          attribute: c.attribute || '',
          rarity: c.rarity || '',
          apSkillType: c.ap_skill_type ?? null,
          apSkillReq: c.ap_skill_req ?? null,
        }))}
        base={base}
        client:load
      />
    </section>
  ))}

  {songs.length > 0 && (
    <section class="mb-6 surface-card p-4" data-testid="event-songs">
      <h2 class="text-lg font-bold text-display mb-3">対象楽曲</h2>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {songs.map(song => (
          <li>
            <a
              href={`${base}songs/${song.id}/`}
              class="pressable block rounded-card border border-gray-200 overflow-hidden hover:border-gray-400"
            >
              <img
                src={songImageUrl(song.id!)}
                alt={song.song_name || ''}
                width="200"
                height="200"
                loading="lazy"
                class="w-full aspect-square object-cover bg-gray-100"
              />
              <div class="p-2">
                <p class="text-sm font-medium text-gray-900 line-clamp-2">{song.song_name}</p>
                <p class="mt-0.5 text-xs text-gray-600 tabular-nums">
                  {song.difficulty} {starsText(song.stars)}
                </p>
                <p class="text-xs text-gray-600 tabular-nums">
                  {song.duration ?? '?'}秒 / {song.notes_count ?? '?'}ノーツ
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

</BaseLayout>
