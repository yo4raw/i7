---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardCompare from '../../components/CardCompare.svelte';
import { fetchCardsJson } from '../../lib/data/fetchCardsJson.ts';
import { fetchSongsJson, filterValidSongs } from '../../lib/data/fetchSongsJson.ts';
import { fetchFixedBroachsJson } from '../../lib/data/fetchFixedBroachsJson.ts';
import { fetchEventsCsv, toEventForBonus } from '../../lib/data/fetchEventsCsv.ts';
import { PAGE_DESCRIPTIONS } from '../../lib/seo.ts';
import ToolGuide from '../../components/seo/ToolGuide.astro';

const [allCards, allSongsRaw, allBroachs, allEvents] = await Promise.all([
  fetchCardsJson(),
  fetchSongsJson(),
  fetchFixedBroachsJson(),
  fetchEventsCsv(),
]);

const allSongs = filterValidSongs(allSongsRaw);
const eventsForBonus = allEvents.map((e) => toEventForBonus(e));
const base = import.meta.env.BASE_URL;
const breadcrumbs = [
  { name: 'ホーム', url: base },
  { name: '衣装比較', url: `${base}card-compare/` },
];
---

<BaseLayout title="衣装比較" description={PAGE_DESCRIPTIONS.cardCompare} breadcrumbs={breadcrumbs}>
  <div class="flex items-baseline justify-between gap-3 flex-wrap mb-1">
    <h1 class="text-2xl font-bold text-display">衣装比較</h1>
    <a href={`${base}card-compare/share/`} class="text-sm underline">この結果を画像で共有</a>
  </div>
  <p class="text-xs text-gray-500 mb-4">
    UR 限定 / 全ノーツ Perfect 前提 / センタースキル除外 / 固有ブローチ装備込み。
    スコアアップ系は期待スコアの積み上げ順、判定縮小系は属性値由来スコア順で並びます（判定縮小系はカバー率でも並び替えできます）。
  </p>

  <CardCompare
    cards={allCards}
    songs={allSongs}
    broachs={allBroachs}
    events={eventsForBonus}
    base={base}
    client:only="svelte"
  />

  <ToolGuide
    summary="楽曲を1曲固定したうえで、全衣装をスコアへの寄与量で並べて比較するツールです。スコアアップスキルと判定縮小スキルはそれぞれ性質が違うため比較軸を分けており、同じ土俵で「どの衣装が強いか」を数値で確認できます。"
    steps={[
      { title: '楽曲を選ぶ', body: 'ノーツ数と属性比率が衣装の寄与量を左右するため、比較の前提として楽曲を固定します。' },
      { title: '比較軸を選ぶ', body: 'スコアアップと判定縮小はタブで切り替えます。並び替えはスコアアップが期待スコア合計と最大スコア合計、判定縮小が属性値由来スコア・期待カバー率・最大カバー率です。' },
      { title: '絞り込む', body: '対象は UR 衣装です。所持衣装を登録していれば手持ちだけの比較にもできます。イベント特効を選ぶと、対象衣装にボーナスを乗せた状態で比較できます。' },
      { title: '詳細を見比べる', body: 'サムネイルをタップすると最大4枚まで詳細パネルに並べられます。発動条件・確率・効果量と、スコアの散らばり方を示す分布を並べて確認できます。' },
    ]}
    notes={[
      'スコアアップの「期待値」は発動確率を掛けた平均的な上乗せ量、「最大値」は全て発動した場合の上乗せ量です。両者の差が大きい衣装ほど確率による目減りが起きやすく、スコアが安定しません。',
      '判定縮小で効くのは、上乗せ量そのものより曲のどれだけの範囲をカバーできるかです。カバー率は曲全体に対する縮小秒数の割合で、100% を超えることもあります（超過分はスコアに乗りません）。',
      '属性値由来のスコアは、スキルとは別にステータスから決まる分です。スキルが弱くても属性値が高ければ総合では上回ることがあるため、参考値として併記しています。',
      '全属性編成やグループ限定が条件の固有ブローチは、条件を満たしたものとして加算しています。実際のゲームではグループ限定はセンターとメンバー4枚がすべて同じグループのときだけ発動するため、編成しだいでは表示値に届きません。楽曲が指定されたブローチは、選択中の曲と一致したときだけ乗ります。前提は詳細パネルに注記しています。',
      '算出値は有志による計測・推定に基づくもので、ゲーム内の挙動と完全に一致することを保証するものではありません。',
    ]}
    faqs={[
      { q: 'スコアアップと判定縮小はどちらを優先すべきですか', a: '曲やスコアの狙い方によって変わります。判定縮小はカバーしている区間の全ノーツに効くため取りこぼしが少なく、スコアアップは当たれば伸びる代わりにブレます。両者の性質の違いと使い分けは「スコア計算 仕様解説」で図つきで説明しています。' },
      { q: '同じ衣装でも曲を変えると順位が変わります', a: '仕様どおりです。ノーツ数が多い曲ほど発動機会が増えてスコアアップが伸び、属性比率が偏った曲では該当属性の衣装が有利になります。狙う曲を決めてから比較してください。' },
    ]}
  />
</BaseLayout>
