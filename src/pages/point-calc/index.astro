---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PointCalc from '../../components/PointCalc.svelte';
import { PAGE_DESCRIPTIONS } from '../../lib/seo.ts';
import ToolGuide from '../../components/seo/ToolGuide.astro';

const base = import.meta.env.BASE_URL;
const breadcrumbs = [
  { name: 'ホーム', url: base },
  { name: 'ポイント芸計算', url: `${base}point-calc/` },
];
---

<BaseLayout title="ポイント芸計算" description={PAGE_DESCRIPTIONS.pointCalc} breadcrumbs={breadcrumbs}>
  <h1 class="text-2xl font-bold text-display mb-4">ポイント芸計算</h1>
  <p class="text-sm text-gray-600 mb-6 text-pretty">
    イベントポイントを狙った数字にぴったり合わせるための計算ツールです。目標ptと現在ptを入れると、
    その差をちょうど埋めるライブの組合せを、ライブ回数の少ない順に提示します。
  </p>

  <PointCalc client:only="svelte" />

  <ToolGuide
    summary="イベントポイントを 7,777,777 のような狙った数字にぴったり合わせる「ポイント芸」のための計算ツールです。目標ptと現在ptの差を埋めるライブの組合せを自動で探索し、どの難易度をどのプレイ方法で何回こなせばよいかを提示します。"
    steps={[
      { title: '目標ptと現在ptを入れる', body: '揃えたい数字と、いま持っているポイントを入力します。ツールはこの差分を埋める組合せを探します。' },
      { title: '特効の上昇率と枚数を入れる', body: '金特効・銀特効・銅特効それぞれの上昇率と、編成に入れられる枚数を指定します。枚数はフレンドから借りる分を含めた6枠分をまとめて入れてください。' },
      { title: '使ってよい条件を選ぶ', body: 'プレイ方法・編成・倍率ライブのうち、実際に使えるものだけを有効にします。獲得ptの差がいちばん大きいのは編成なので、ここは手持ちに合わせて正確に選んでください。' },
      { title: '結果を確認する', body: '差をちょうど埋める組合せを優先して提示します。候補の各行にはその pt を出す条件が併記されるので、手元で検算できます。ぴったりが作れないときは、いちばん近い候補が「残り N pt」付きで出ます。' },
    ]}
    notes={[
      '獲得ptはイベントごとの早見表を使わず、難易度・楽曲の★・プレイ係数・特効率・ユニットボーナス・コンボボーナスの6つから式で算出しています。イベントごとに表を用意する必要がないため、新しいイベントでもそのまま使えます。',
      '上昇率の初期値はよくある刻みを入れてあります。イベントごとに違うので、実際の値に書き換えてください。表記は金特効・銀特効・銅特効に統一しています。',
      'ポイント計算上は各段階の合計枚数しか効かないため、フレンド枠を分けて入力する必要はありません。',
      '算出値は有志による計測・推定に基づくもので、ゲーム内の挙動と完全に一致することを保証するものではありません。実際に走らせる前に、少ない回数で数値が合うか確認することを勧めます。',
    ]}
    faqs={[
      { q: 'ぴったりの組合せが見つかりません', a: '使ってよい条件を増やすと解が見つかりやすくなります。プレイ方法や倍率ライブの選択肢を広げるか、目標ptを見直してください。' },
      { q: 'ポイント芸とは何ですか', a: 'ポイント系イベントの最終獲得ポイントを、ゾロ目やキリのよい数字にぴったり揃える遊びです。ゲームの有利不利には影響しませんが、達成には獲得ptの正確な把握が要ります。' },
    ]}
  />
</BaseLayout>
