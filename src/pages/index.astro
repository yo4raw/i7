---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCountdown from '../components/EventCountdown.svelte';
import CharacterColorHero from '../components/CharacterColorHero.svelte';
import { fetchCardsJson } from '../lib/data/fetchCardsJson.ts';
import { fetchSongsJson } from '../lib/data/fetchSongsJson.ts';
import { fetchEventsCsv } from '../lib/data/fetchEventsCsv.ts';
import { RARITIES, RARITY_BADGE_CLASSES } from '../lib/constants.ts';
import { PAGE_DESCRIPTIONS } from '../lib/seo.ts';

const [cards, songs, events] = await Promise.all([
  fetchCardsJson(),
  fetchSongsJson(),
  fetchEventsCsv(),
]);

const rarityCounts: Record<string, number> = {};
for (const card of cards as Array<{ rarity?: string }>) {
  const r = card.rarity || '不明';
  rarityCounts[r] = (rarityCounts[r] || 0) + 1;
}
const rarityEntries = RARITIES
  .map((r) => [r, rarityCounts[r] ?? 0] as const)
  .filter(([, n]) => n > 0);

const now = new Date();
const sortedEvents = [...events].toSorted((a, b) => b.id - a.id);
const liveEvents = sortedEvents.filter((ev) => {
  const start = new Date(`${ev.start_date}T17:00:00+09:00`);
  const end = new Date(`${ev.end_date}T17:00:00+09:00`);
  return start <= now && now < end;
});
const upcomingEvents = sortedEvents
  .filter((ev) => new Date(`${ev.start_date}T17:00:00+09:00`) > now)
  .toSorted((a, b) => a.start_date.localeCompare(b.start_date))
  .slice(0, 1);

const base = import.meta.env.BASE_URL;

const stats = [
  { label: '衣装', value: cards.length, unit: '枚', href: `${base}cards/` },
  { label: '楽曲', value: songs.length, unit: '曲', href: `${base}songs/` },
  { label: 'イベント', value: events.length, unit: '件', href: `${base}events/` },
];

type FeatureCard = { href: string; title: string; desc: string; stat?: { value: number; unit: string } };

const databaseCards: FeatureCard[] = [
  { href: `${base}cards/`, title: '衣装一覧', desc: 'レアリティ・属性・キャラクター・スキルタイプで絞り込み。開催中イベントの特効フィルタや所持数入力にも対応。', stat: { value: cards.length, unit: '枚' } },
  { href: `${base}songs/`, title: '楽曲一覧', desc: '楽曲ごとのノーツ属性比率・ノーツ内訳・Lv 別情報を確認。スコア計算へそのまま持ち込めます。', stat: { value: songs.length, unit: '曲' } },
  { href: `${base}events/`, title: 'イベント情報', desc: '開催中・過去イベントの一覧と、各イベントの特効衣装・効果量を確認できます。', stat: { value: events.length, unit: '件' } },
];

const toolCards: FeatureCard[] = [
  { href: `${base}score-calc/`, title: 'スコア計算', desc: 'デッキ・楽曲・ブローチを選び、モンテカルロシミュレーションでスコア分布を推定。' },
  { href: `${base}score-calc/max-score-finder/`, title: '編成組合計算', desc: '所持衣装の中から理論値が最大になる編成を総当たりで探索。所持縛りモードあり。' },
  { href: `${base}card-compare/`, title: '衣装比較', desc: '楽曲を固定し、スコアアップ・判定縮小の期待値／最大値で全衣装をランキング比較。' },
];

const registerCards: FeatureCard[] = [
  { href: `${base}mycard/`, title: '所持衣装', desc: '手元にある衣装の所持数を入力・集計。レアリティ別の所持状況も一目で確認。' },
  { href: `${base}shared-broach/`, title: '共通ブローチ', desc: '共通ブローチの所持数を登録し、スコア計算・編成探索のブローチ効果へ反映。' },
  { href: `${base}decks/`, title: '保存デッキ', desc: '構築したデッキを端末の localStorage に保存・呼び出し。名前を付けて使い分け可能。' },
  { href: `${base}rabbit-note/`, title: 'ラビットノート', desc: 'ラビットノートの投入レベルを入力し、スコア計算のベーススコアへ自動反映。' },
];

const categories: { heading: string; cards: FeatureCard[] }[] = [
  { heading: 'データベース', cards: databaseCards },
  { heading: 'スコア計算ツール', cards: toolCards },
  { heading: '登録・管理', cards: registerCards },
];
---

<BaseLayout title="ホーム" description={PAGE_DESCRIPTIONS.home}>
  <!-- ヒーロー: 16 色バーを大判スケールで反復 (ADR 0047) -->
  <CharacterColorHero base={base} client:load />
  <div class="flex flex-wrap gap-3 mt-4 mb-6">
    {stats.map((s) => (
      <a href={s.href}
         class="flex items-baseline gap-1.5 px-4 py-2 rounded-lg bg-gray-100 border border-gray-200 hover:border-chrome-ink transition-colors">
        <span class="text-xs text-gray-500">{s.label}</span>
        <span class="text-xl font-bold tabular-nums text-gray-900">{s.value.toLocaleString('ja-JP')}</span>
        <span class="text-xs text-gray-500">{s.unit}</span>
      </a>
    ))}
  </div>

  <!-- 開催中／次回イベント -->
  <EventCountdown
    events={liveEvents.length > 0 ? liveEvents : upcomingEvents}
    heading={liveEvents.length > 0 ? '開催中のイベント' : '次回イベント'}
    base={base}
    client:load
  />

  <!-- 主な機能 -->
  <section class="mb-8">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="text-lg font-bold text-display text-gray-900">主な機能</h2>
      <p class="text-xs text-gray-500">各ページはヘッダーナビゲーションからもアクセスできます</p>
    </div>

    {categories.map((cat) => (
      <div class="mb-6">
        <h3 class="text-sm font-semibold text-gray-600 mb-2">{cat.heading}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {cat.cards.map((c) => (
            <a href={c.href}
               class="block surface-card border-l-4 border-chrome-ink p-5 hover:shadow-card-hover transition-shadow">
              <h4 class="text-base font-semibold text-gray-900 mb-1">{c.title}</h4>
              <p class="text-xs text-gray-600">{c.desc}</p>
              {c.stat && (
                <div class="text-2xl font-bold tabular-nums text-gray-800 mt-3">{c.stat.value.toLocaleString('ja-JP')}<span class="text-sm text-gray-500 ml-1">{c.stat.unit}</span></div>
              )}
            </a>
          ))}
        </div>
      </div>
    ))}

    <p class="text-xs text-gray-500">
      所持衣装数・ラビットノート値・共通ブローチ・保存デッキなどのユーザーデータは、閲覧している端末の <code class="px-1 py-0.5 bg-gray-100 rounded">localStorage</code> にのみ保存されます。サーバーへは送信されません。
    </p>
  </section>

  <!-- 衣装内訳 -->
  <section class="mb-8">
    <h2 class="text-lg font-bold text-display text-gray-900 mb-3">衣装内訳</h2>
    <div class="surface-card p-5">
      <div class="flex flex-wrap gap-2">
        {rarityEntries.map(([rarity, count]) => (
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-50 border border-gray-200 text-sm">
            <span class={`inline-block px-2 py-0.5 rounded text-xs font-bold text-white ${RARITY_BADGE_CLASSES[rarity] ?? 'bg-gray-400'}`}>{rarity}</span>
            <span class="text-gray-700">{count}<span class="text-xs text-gray-500 ml-0.5">枚</span></span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- 謝辞 -->
  <section class="surface-card p-6 mb-6">
    <h2 class="text-lg font-bold text-display text-gray-900 mb-3">謝辞</h2>
    <dl class="text-sm text-gray-700 space-y-3 mb-4">
      <div class="flex flex-col sm:flex-row sm:gap-4">
        <dt class="font-semibold sm:w-40 shrink-0">各種データの取得元</dt>
        <dd>
          <a href="https://i7.step-on-dream.net/" target="_blank" rel="noopener noreferrer" class="text-gray-900 underline underline-offset-2 decoration-gray-400 hover:decoration-gray-900">【非公式】アイドリッシュセブン 衣装データベース</a>
        </dd>
      </div>
      <div class="flex flex-col sm:flex-row sm:gap-4">
        <dt class="font-semibold sm:w-40 shrink-0">スコア計算の仕様参考</dt>
        <dd>
          <a href="https://ota-life.com/id7-score/" target="_blank" rel="noopener noreferrer" class="text-gray-900 underline underline-offset-2 decoration-gray-400 hover:decoration-gray-900">オタライフ |【アイナナ】スコア計算のやり方【スコアタ攻略】</a>
        </dd>
      </div>
    </dl>
    <p class="text-sm text-gray-700 mb-2">
      本サイト作成の際、下記のお二人には多大なるお力添えをいただきました。感謝いたします。
    </p>
    <ul class="list-disc pl-5 space-y-1 text-sm text-gray-700">
      <li>
        <a href="https://x.com/megoonarite" target="_blank" rel="noopener noreferrer" class="text-gray-900 underline underline-offset-2 decoration-gray-400 hover:decoration-gray-900">@megoonarite</a>
      </li>
      <li>
        <a href="https://x.com/miyaaaaaki_i7" target="_blank" rel="noopener noreferrer" class="text-gray-900 underline underline-offset-2 decoration-gray-400 hover:decoration-gray-900">@miyaaaaaki_i7</a>
      </li>
    </ul>
  </section>

  <!-- お問い合わせ -->
  <section class="surface-card p-6 mb-6">
    <h2 class="text-lg font-bold text-display text-gray-900 mb-3">お問い合わせ</h2>
    <p class="text-sm text-gray-700 mb-2">
      ご意見・ご要望・不具合報告・権利に関するお問い合わせは、以下のいずれかへお願いいたします。
    </p>
    <ul class="list-disc pl-5 space-y-1 text-sm text-gray-700">
      <li>
        X : <a href="https://x.com/i7_tool" target="_blank" rel="noopener noreferrer" class="text-gray-900 underline underline-offset-2 decoration-gray-400 hover:decoration-gray-900">@i7_tool</a>
      </li>
    </ul>
  </section>

  <!-- プライバシー -->
  <section class="surface-card p-6 mb-6">
    <h2 class="text-lg font-bold text-display text-gray-900 mb-3">プライバシー</h2>
    <ul class="list-disc pl-5 space-y-1 text-sm text-gray-700">
      <li>所持衣装・デッキ・ラビットノート値・共通ブローチなどのユーザー入力は、ブラウザの <code class="px-1 py-0.5 bg-gray-100 rounded">localStorage</code> のみに保存され、サーバーへ送信されません。</li>
      <li>データのエクスポート・完全削除はブラウザの設定または各ページ上のクリア機能から行えます。</li>
    </ul>
  </section>

  <!-- 免責事項・権利表記 -->
  <section class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
    <h2 class="text-lg font-bold text-yellow-800 mb-3">免責事項・権利表記</h2>
    <ul class="list-disc pl-5 space-y-2 text-sm text-gray-800">
      <li>
        当サイトはアイドリッシュセブン運営・開発元とは一切関係のない、ファンによる<strong>非公式</strong>のデータベースサイトです。
      </li>
      <li>
        『アイドリッシュセブン』および関連するキャラクター・画像・楽曲・ロゴ等の著作権・商標権は、株式会社バンダイナムコオンライン、株式会社バンダイナムコエンターテインメント、株式会社バンダイナムコピクチャーズ、その他の権利者に帰属します。
      </li>
      <li>
        衣装画像は利用者の利便性のために各ゲームサーバーより取得・キャッシュしているものであり、画像そのものの権利は元の権利者に帰属します。画像・データの無断転載・商用利用はご遠慮ください。
      </li>
      <li>
        当サイトに掲載されている数値・仕様・スコア計算結果は、有志による計測・推定値を含みます。ゲーム内の挙動と完全に一致することを保証するものではありません。
      </li>
      <li>
        当サイトの利用により生じたいかなる損害についても、運営者は責任を負いません。
      </li>
      <li>
        権利者様からの削除・修正依頼がございましたら、上記「お問い合わせ」の連絡先までご連絡ください。
      </li>
    </ul>
  </section>
</BaseLayout>
