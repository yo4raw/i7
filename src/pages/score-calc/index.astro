---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScoreCalc from '../../components/ScoreCalc.svelte';
import { fetchCardsJson } from '../../lib/data/fetchCardsJson.ts';
import { fetchSongsJson, filterValidSongs } from '../../lib/data/fetchSongsJson.ts';
import { fetchFixedBroachsJson } from '../../lib/data/fetchFixedBroachsJson.ts';
import { fetchEventsCsv, toEventForBonus } from '../../lib/data/fetchEventsCsv.ts';
import { PAGE_DESCRIPTIONS } from '../../lib/seo.ts';
import ToolGuide from '../../components/seo/ToolGuide.astro';

const [allCards, allSongsRaw, allBroachs, allEvents] = await Promise.all([
  fetchCardsJson(),
  fetchSongsJson(),
  fetchFixedBroachsJson(),
  fetchEventsCsv(),
]);

const allSongs = filterValidSongs(allSongsRaw);

const eventsForBonus = allEvents.map((e) => toEventForBonus(e));

const base = import.meta.env.BASE_URL;
const breadcrumbs = [
  { name: 'ホーム', url: base },
  { name: 'スコア計算', url: `${base}score-calc/` },
];
---

<BaseLayout title="スコア計算" description={PAGE_DESCRIPTIONS.scoreCalc} breadcrumbs={breadcrumbs}>
  <div class="flex items-baseline gap-3 mb-4 flex-wrap">
    <h1 class="text-2xl font-bold text-display">スコア計算</h1>
    <a href={`${base}score-calc/spec/`} class="text-sm text-gray-900 underline underline-offset-2 decoration-gray-400 hover:decoration-gray-900">仕様について →</a>
  </div>

  <ScoreCalc
    cards={allCards}
    songs={allSongs}
    broachs={allBroachs}
    events={eventsForBonus}
    base={base}
    client:only="svelte"
  />

  <ToolGuide
    summary="楽曲・編成・ブローチを指定して、そのライブで出るスコアを試算するツールです。理論上の最小値と最大値に加えて、実際にどのくらいのスコアへ落ち着きやすいかも分布で確認できます。分布は、スキルの発動を乱数で繰り返すモンテカルロシミュレーションで求めます。"
    steps={[
      { title: '楽曲を選ぶ', body: '楽曲を選ぶと、その曲のノーツ数・属性比率が読み込まれます。ノーツの属性構成はチーム属性値の効き方に直結するため、最初に決めます。' },
      { title: '編成を組む', body: 'センター・メンバー4枚・フレンドの6スロットに衣装を配置します。所持衣装を登録しておくと、所持しているものだけに絞って選べます。' },
      { title: 'ブローチと特効を設定する', body: '固有ブローチは衣装に紐づいて自動で付きます。共通ブローチはスロットごとに手で選びます。所持数を登録して「所持ブローチ縛り」を ON にすると、選択肢が所持数の範囲に絞られます。開催中イベントの特効段階は衣装を置いた時点で入り、スロットごとに金・銀・銅を変えることもできます。' },
      { title: '計算を実行する', body: '試行回数を指定して実行すると、スコア分布のヒストグラム・平均値・スキル発動統計が出ます。試行回数を増やすほど分布は安定しますが、計算時間も伸びます。' },
    ]}
    notes={[
      '理論最小値はスキルが一度も発動しなかった場合、理論最大値はすべて発動した場合のスコアです。実際のスコアはこの間に収まります。',
      '判定縮小スキルは、発動している間のノーツの判定を引き上げてスコアを底上げします。曲の先頭側のノーツは縮小の計算対象から外れます。またカバー率は 100% を超えることがあり、超過した分はスコアに乗りません。',
      '複数の判定縮小スキルが同時に効いている区間では、効果は按分されます。単純な足し算にはなりません。',
      'スコアアップスキルには発動条件（コンボ数・秒数など）と発動確率があります。期待値は「発動しうる回数 × 発動確率 × 効果量」で求めます。この式には確率による目減りが織り込まれています。',
      '算出値は有志による計測・推定に基づくもので、ゲーム内の挙動と完全に一致することを保証するものではありません。',
    ]}
    faqs={[
      { q: '理論値と期待値とシミュレーション結果はどう違いますか？', a: '理論値はスキルが全く発動しない／全部発動する両極端の値です。期待値は発動確率を掛けた算術平均で、1回のライブの平均的な着地点を表します。シミュレーションは実際に乱数で発動を再現した結果の分布で、平均だけでなく「どのくらいブレるか」が分かります。' },
      { q: '計算の詳しい仕組みを知りたい', a: '「スコア計算 仕様解説」ページで全段階を図つきで説明しています。チーム属性値の求め方から、1ノーツの素点、スコアアップ・判定縮小の上乗せ、最終補正までを順に追えます。' },
      { q: '入力したデータはどこに保存されますか？', a: '所持衣装・保存デッキ・共通ブローチなどはすべてお使いの端末の localStorage にのみ保存されます。サーバーへは送信されません。' },
    ]}
  />
</BaseLayout>
