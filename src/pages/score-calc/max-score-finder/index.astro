---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MaxScoreFinder from '../../../components/MaxScoreFinder.svelte';
import { fetchCardsJson } from '../../../lib/data/fetchCardsJson';
import { fetchSongsJson, filterValidSongs } from '../../../lib/data/fetchSongsJson';
import { fetchFixedBroachsJson } from '../../../lib/data/fetchFixedBroachsJson';
import { fetchEventsCsv, toEventForBonus } from '../../../lib/data/fetchEventsCsv';
import { PAGE_DESCRIPTIONS } from '../../../lib/seo';
import ToolGuide from '../../../components/seo/ToolGuide.astro';

const [allCards, allSongsRaw, allBroachs, allEvents] = await Promise.all([
  fetchCardsJson(),
  fetchSongsJson(),
  fetchFixedBroachsJson(),
  fetchEventsCsv(),
]);

const allSongs = filterValidSongs(allSongsRaw);

const eventsForBonus = allEvents.map((e) => toEventForBonus(e));

const base = import.meta.env.BASE_URL;

const breadcrumbs = [
  { name: 'ホーム', url: base },
  { name: 'スコア計算', url: `${base}score-calc/` },
  { name: '編成組合計算', url: `${base}score-calc/max-score-finder/` },
];
---

<BaseLayout title="編成組合計算" description={PAGE_DESCRIPTIONS.maxScoreFinder} breadcrumbs={breadcrumbs}>
  <h1 class="text-2xl font-bold text-display mb-4">編成組合計算 — スコアが最大になる編成を探す</h1>
  <p class="text-xs text-gray-500 mb-4">
    楽曲とイベントを選ぶと、スコアが最大になる 6 枚編成（フレンド含む）を総当たりで探索します。探索の対象は、選んだハイスコアライブイベントの <b>金特効</b> / <b>銀特効</b> にあたる UR 衣装だけです。過去のハイスコアイベントも選べます。
    <br />同じ衣装を複数スロットに配置することも許容します（例: 金特効を複数スロットに重複装備）。
    <br />スキルレベルは全て Lv5 / 特訓済み前提。固有ブローチは条件を満たすものを自動装着してスコアに反映します（衣装詳細表示で確認できます）。共通ブローチは既定では未装着として扱います。「所持共通ブローチを割り当てる」を ON にすると、登録済みの所持ブローチを自動で割り当てます。
  </p>

  <MaxScoreFinder
    cards={allCards}
    songs={allSongs}
    broachs={allBroachs}
    events={eventsForBonus}
    base={base}
    client:load
  />

  <ToolGuide
    summary="指定したハイスコアライブイベントの金特効・銀特効 UR 衣装の中から、最もスコアが高くなる6枚編成を総当たりで探索するツールです。候補を絞り込んだうえで全ての組合せを実際に評価するため、勘や経験則に頼らずに済みます。所持衣装を登録すれば、手持ちだけで組める編成に絞ることもできます。"
    steps={[
      { title: '対象イベントを選ぶ', body: '開催中または過去のハイスコアライブイベントを選びます。探索対象は選んだイベントの金特効・銀特効に含まれる UR 衣装に限定されます。' },
      { title: '楽曲を選ぶ', body: '楽曲ごとにノーツ数と属性比率が違うため、同じ編成でも最適解は変わります。狙う曲を指定してください。' },
      { title: '所持条件とブローチを設定する', body: '「所持衣装で検索」を ON にすると、手元にある衣装だけで組める編成に絞れます。共通ブローチは、所持数を登録したうえで「所持共通ブローチを割り当てる」を ON にすると、効果が高くなる割り当ても含めて探索します。どちらも既定は OFF です。' },
      { title: '探索を実行する', body: '組合せ数が多い場合は確認が出ます。実行するとブラウザ内で並列に総当たり計算が走り、最適編成と上位候補 TOP 10、フレンド枠の差し替え候補が表示されます。' },
    ]}
    notes={[
      '探索も評価もすべてブラウザ内で完結します。所持データがサーバーへ送られることはありません。',
      '評価指標は「算術期待値」が既定です。スキルの発動確率を織り込んだ平均的な着地点で選ぶため、実戦向きの編成になります。理論最大値（全スキル発動）での評価にも切り替えられます。',
      'フレンド枠は自分の所持と関係なく候補に入ります。ただし実際のマッチングでは1位の候補を借りられないことがあります。そのため、センターとメンバー4枚を固定してフレンドだけ差し替えた候補も併せて表示します。',
      '「判定縮小2枚以上編成」を ON にすると、縮小持ちが合計2枚以上になる編成だけを探索します（既定は OFF）。縮小は枚数が増えるほどカバー率が伸びるため、それを前提に候補を絞りたいときに使います。',
      'ハイスコアライブイベントの特効は UR 衣装のみが対象です。SSR 以下は探索候補に含まれません。',
      'グループ限定が条件の固有ブローチは、同グループ編成でなくても発動したものとして加算して探索します。実際のゲームではセンターとメンバー4枚がすべて同じグループのときだけ発動するため、混成の編成では表示スコアに届きません。該当する編成には結果側にも注記を出します。',
      '算出値は有志による計測・推定に基づくもので、ゲーム内の挙動と完全に一致することを保証するものではありません。',
    ]}
    faqs={[
      { q: '探索に時間がかかります', a: '候補衣装が多いほど組合せは急激に増えます。所持衣装を登録して候補を絞ると大幅に速くなります。計算はお使いの端末の CPU を並列に使って行われるため、他のタブを閉じると改善することがあります。' },
      { q: 'スコア計算ページの結果と数字が違う', a: 'このツールは編成の優劣を比較するために算術期待値で評価します。スコア計算ページのシミュレーションは乱数で発動を再現した結果なので1回ごとにブレます。平均を取れば近い値に収束します。また、このツールはグループ限定の固有ブローチを発動扱いで加算しますが、スコア計算ページは実際の編成どおりに判定するため、その分の差が出ることがあります。' },
      { q: '過去のイベントも選べますか', a: '選べます。終了済みイベントの特効構成で編成を試算できるため、次のイベントに向けた育成方針の検討にも使えます。' },
    ]}
  />
</BaseLayout>
