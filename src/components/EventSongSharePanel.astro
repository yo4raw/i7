---
import EventShareImage from './EventShareImage.svelte';
import BroachRankingChart from './score/BroachRankingChart.svelte';
import { formatEventPeriod } from '../lib/data/eventPeriod';
import { type EventRow } from '../lib/data/fetchEventsCsv';
import { type Song } from '../lib/data/fetchSongsJson';
import { ATTR_BADGE_BG, SITE_NAME } from '../lib/constants';
import { attrDonutSvg } from '../lib/donutChart';
import { songImageUrl, starsText } from '../lib/ui';
import { buildBroachRanking } from '../lib/score/songBroachRanking';

interface Props {
  event: EventRow;
  songs: Song[];
  /** ダウンロード画像のファイル名（拡張子なし） */
  shareFilename: string;
}

const { event, songs, shareFilename } = Astro.props as Props;

// 最短曲（秒数が最小の曲）。同秒の曲が複数あればすべてに付ける
const durations = songs.map(s => s.duration).filter((d): d is number => typeof d === 'number' && d > 0);
const minDuration = durations.length > 0 ? Math.min(...durations) : null;

// 1 曲 = 1 パネル = 1 枚の PNG
const panels = songs.map((song, i) => {
  const sr = song.shout_ratio || 0;
  const br = song.beat_ratio || 0;
  const mr = song.melody_ratio || 0;
  const total = sr + br + mr;
  return {
    id: `share-panel-${i}`,
    suffix: `_${i + 1}`,
    song,
    ratios: total > 0
      ? ([
          { attr: 'Shout', pct: Math.round(sr * 100) },
          { attr: 'Beat', pct: Math.round(br * 100) },
          { attr: 'Melody', pct: Math.round(mr * 100) },
        ] as const)
      : [],
    donutHtml: total > 0 ? attrDonutSvg(sr, br, mr, { sizeClass: 'size-full', strokeWidth: 4 }) : '',
    ranking: buildBroachRanking(song),
    isShortest: minDuration !== null && song.duration === minDuration,
  };
});
---

<div class="mb-3 flex items-center justify-between gap-3 flex-wrap max-w-3xl">
  <p class="text-sm text-gray-600">
    下の枠をスクリーンショット、または右のボタンで画像保存して SNS でシェアできます。1 曲につき 1 枚、全 {panels.length} 枚に分けて保存します。
  </p>
  <EventShareImage
    filename={shareFilename}
    panels={panels.map(p => ({ id: p.id, suffix: p.suffix }))}
    client:load
  />
</div>

<!-- スクショ対象パネル（端末によらず同じダウンロード画像になるよう幅固定。狭い画面では横スクロール） -->
<div class="overflow-x-auto pb-2 space-y-4">
  {panels.map(panel => (
    <div id={panel.id} class="w-[880px] shrink-0 rounded-xl border border-gray-200 shadow-lg overflow-hidden bg-white">
      <!-- ヘッダー帯 -->
      <div class="bg-chrome-ink text-white px-4 py-3">
        <div class="flex items-baseline justify-between gap-2 flex-wrap">
          <h2 class="text-lg sm:text-xl font-bold leading-snug">{event.eventname}<span class="ml-2 text-sm font-semibold text-gray-300">対象楽曲</span></h2>
          <span class="text-xs font-semibold text-gray-300 whitespace-nowrap">{SITE_NAME}</span>
        </div>
        <div class="mt-1 text-xs text-gray-300 space-x-2">
          <span>{event.eventtype}</span>
          <span>/</span>
          <span>{formatEventPeriod(event.start_date, event.end_date)}</span>
        </div>
      </div>

      <div class="p-4 flex gap-4">
        <!-- ジャケット + 曲情報 -->
        <div class="w-44 shrink-0">
          <div class="relative">
            <img
              src={songImageUrl(panel.song.id!)}
              alt={panel.song.song_name || ''}
              width="200"
              height="200"
              class="w-full aspect-square object-cover rounded-lg bg-gray-100"
            />
            {panel.isShortest && (
              <span class="absolute top-1.5 left-1.5 rounded-md bg-chrome-ink px-2 py-1 text-xs font-bold text-white shadow-md">最短曲</span>
            )}
          </div>
          <p class="mt-2 text-base font-bold leading-snug text-gray-900">{panel.song.song_name}</p>
          <p class="text-xs text-gray-600">{panel.song.artist}</p>
          <p class="mt-1 text-xs text-gray-600 tabular-nums">
            {panel.song.difficulty}{panel.song.stars ? ` ${starsText(panel.song.stars)}` : ''}
          </p>
          <p class="text-xs text-gray-600 tabular-nums">
            {panel.song.duration ?? '?'}秒 / {(panel.song.notes_count ?? 0).toLocaleString()}ノーツ
          </p>
        </div>

        <!-- 属性比率 -->
        {panel.ratios.length > 0 && (
          <div class="w-40 shrink-0">
            <p class="text-xs font-semibold text-gray-500 mb-2">属性比率</p>
            <div class="size-24 mx-auto" set:html={panel.donutHtml} />
            <div class="mt-2 space-y-1">
              {panel.ratios.map(r => (
                <div class="flex items-center gap-2">
                  <span class={`size-2.5 rounded-full inline-block ${ATTR_BADGE_BG[r.attr]}`}></span>
                  <span class="text-xs font-medium w-14">{r.attr}</span>
                  <span class="text-xs tabular-nums">{r.pct}%</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- 共通ブローチ スコア寄与 -->
        {panel.ranking.length > 0 && (
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 mb-2">共通ブローチ スコア寄与 TOP{panel.ranking.length}</p>
            <BroachRankingChart ranking={panel.ranking} />
          </div>
        )}
      </div>
    </div>
  ))}
</div>
